{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "not": {
          "required": [
            "value",
            "valueFrom"
          ]
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "spiffe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "csiDriver": {
          "type": "string",
          "minLength": 1
        },
        "trustDomain": {
          "type": "string"
        },
        "socketPath": {
          "type": "string",
          "description": "SPIFFE Workload API Unix socket; empty preserves upstream auto-discovery.",
          "pattern": "^$|^/run/spire/sockets/[^/]+$"
        }
      }
    },
    "multusHostConfDir": {
      "type": "string",
      "pattern": "^/"
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "octelium-common": {
      "type": "object"
    },
    "global": {
      "type": "object"
    },
    "resourceServer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "port",
        "headless"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "description": "Backend DNS hostname or raw IPv4/IPv6 literal, without URL scheme or port.",
          "anyOf": [
            {
              "format": "hostname"
            },
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ],
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "headless": {
          "type": "boolean"
        }
      }
    },
    "securityContext": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "extraInitContainers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "image"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mountPath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prefix": {
            "type": "string"
          },
          "configMapRef": {
            "type": "object"
          },
          "secretRef": {
            "type": "object"
          }
        },
        "oneOf": [
          {
            "required": [
              "configMapRef"
            ]
          },
          {
            "required": [
              "secretRef"
            ]
          }
        ]
      }
    },
    "regionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        }
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "definitions": {},
  "required": [
    "regionRef"
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "not": {
          "required": [
            "value",
            "valueFrom"
          ]
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "spiffe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "csiDriver": {
          "type": "string",
          "minLength": 1
        },
        "socketPath": {
          "type": "string",
          "description": "SPIFFE Workload API Unix socket used by Envoy's SPIRE SDS connection.",
          "pattern": "^/run/spire/sockets/[^/]+$"
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "externalIPs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalTrafficPolicy": {
          "enum": [
            "Cluster",
            "Local"
          ]
        },
        "loadBalancerClass": {
          "type": "string"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "nodePort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "octelium-common": {
      "type": "object"
    },
    "global": {
      "type": "object"
    },
    "xds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "anyOf": [
            {
              "format": "hostname"
            },
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ]
        }
      }
    },
    "frontProxy": {
      "type": "boolean"
    },
    "securityContext": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "extraInitContainers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "image"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mountPath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extraEnvFrom": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "prefix": {
            "type": "string"
          },
          "configMapRef": {
            "type": "object"
          },
          "secretRef": {
            "type": "object"
          }
        },
        "oneOf": [
          {
            "required": [
              "configMapRef"
            ]
          },
          {
            "required": [
              "secretRef"
            ]
          }
        ]
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
